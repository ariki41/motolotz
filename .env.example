APP_NAME=MotoLotz
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Tokyo
APP_URL=http://localhost

YOLP_CACHE_TTL_SECONDS=86400

APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14
LOG_QUERY_DAILY_DAYS=14
QUERY_LOG_ENABLED=false
QUERY_LOG_SLOW_MS=500

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=bike_parking
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

YOLP_URL=https://map.yahooapis.jp/search/local/V1/localSearch
YOLP_GEOCODE_URL=https://map.yahooapis.jp/geocode/V1/geoCoder
YOLP_CLIENT_ID=

# Optional: override the official Japan Post UTF-8 postal-code ZIP URL.
# JAPAN_POST_POSTAL_CODE_URL=https://www.post.japanpost.jp/service/search/zipcode/download/utf/zip/utf_ken_all.zip

# Optional: path to the postal-code coordinate CSV used only by JapanParkingSpotSeeder.
# PARKING_SPOT_SAMPLE_POSTALCODE_CSV=/path/to/postalcode.csv

# Advertising is disabled until both the AdSense publisher ID and required ad slots are set.
ADVERTISING_ENABLED=false
CONTACT_FORM_URL=
CONTACT_EMAIL=bikeparking819.app@gmail.com
ADSENSE_CLIENT=
ADSENSE_SLOT_HOME_FOOTER=
ADSENSE_SLOT_PARKING_SPOT_FOOTER=
