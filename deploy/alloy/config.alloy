// This endpoint is reachable only inside the Tailscale tailnet.
loki.write "raspberry_pi" {
	endpoint {
		url = sys.env("LOKI_URL")
	}

	external_labels = {
		application = "motolotz",
		environment = "production",
		host        = constants.hostname,
	}
}

// This is a second line of defence for values that can appear in web-server
// request URLs or errors outside Laravel's logging pipeline.
loki.process "redact" {
	forward_to = [loki.write.raspberry_pi.receiver]

	stage.match {
		selector      = `{job="nginx-access"}`
		pipeline_name = "nginx_access_timestamp"

		stage.json {
			expressions = { log_timestamp = "time" }
		}

		stage.timestamp {
			source            = "log_timestamp"
			format            = "RFC3339"
			action_on_failure = "skip"
		}
	}

	stage.match {
		selector      = `{job=~"laravel|laravel-query"}`
		pipeline_name = "laravel_timestamp"

		stage.json {
			expressions = { log_timestamp = "datetime" }
		}

		stage.timestamp {
			source            = "log_timestamp"
			format            = "RFC3339Nano"
			action_on_failure = "skip"
		}
	}

	stage.match {
		selector      = `{job="nginx-error"}`
		pipeline_name = "nginx_error_fields"

		stage.regex {
			expression = "^(?P<timestamp>\\S+ \\S+) \\[(?P<error_level>[^\\]]+)\\] (?P<message>.*)$"
		}

		stage.regex {
			expression = "(?:^|, )client: (?P<client>[^,]+)"
			source     = "message"
		}

		stage.regex {
			expression = "(?:^|, )server: (?P<server>[^,]+)"
			source     = "message"
		}

		stage.regex {
			expression = "(?:^|, )request: \\\"(?P<request>[^\\\"]*)\\\""
			source     = "message"
		}

		stage.regex {
			expression = "(?:^|, )upstream: \\\"(?P<upstream>[^\\\"]*)\\\""
			source     = "message"
		}

		stage.regex {
			expression = "(?:^|, )request_id: (?P<request_id>[A-Za-z0-9._:-]+)"
			source     = "message"
		}

		stage.timestamp {
			source            = "timestamp"
			format            = "2006/01/02 15:04:05"
			location          = "Asia/Tokyo"
			action_on_failure = "skip"
		}

		stage.pack {
			labels           = ["timestamp", "error_level", "message", "client", "server", "request", "upstream", "request_id"]
			ingest_timestamp = false
		}
	}

	stage.replace {
		expression = `(?i)(?:password|passwd|pwd|cookie|token|authorization|api[_-]?key|secret)(?:=|%3d|"\s*:\s*")(?P<sensitive_value>[^&\s",}]+)`
		replace    = "[REDACTED]"
	}

	stage.replace {
		expression = `(?i)bearer\s+(?P<bearer_value>[^\s",}]+)`
		replace    = "[REDACTED]"
	}
}

local.file_match "laravel" {
	path_targets = [{
		__path__ = "/var/www/html/storage/logs/laravel*.log",
		job      = "laravel",
	}]
}

loki.source.file "laravel" {
	targets    = local.file_match.laravel.targets
	forward_to = [loki.process.redact.receiver]
}

local.file_match "query" {
	path_targets = [{
		__path__ = "/var/www/html/storage/logs/query*.log",
		job      = "laravel-query",
	}]
}

loki.source.file "query" {
	targets    = local.file_match.query.targets
	forward_to = [loki.process.redact.receiver]
}

local.file_match "nginx" {
	path_targets = [
		{
			__path__ = "/var/log/nginx/motolotz_access.json.log",
			job      = "nginx-access",
		},
		{
			__path__ = "/var/log/nginx/error.log",
			job      = "nginx-error",
		},
	]
}

loki.source.file "nginx" {
	targets    = local.file_match.nginx.targets
	forward_to = [loki.process.redact.receiver]
}
